# Copy to .env.development / .env.production / .env.local as needed (gitignored).
# Vite only exposes variables prefixed with VITE_.

# Development (npm run dev) — UAT
# VITE_SMS_API_BASE_URL=https://uat-sms.skyfi.com.vn/api/sms

# Production (npm run build) — set by DevOps/CI or local .env.production
# VITE_SMS_API_BASE_URL=https://sms.skyfi.com.vn/api/sms

VITE_SMS_API_BASE_URL=https://uat-sms.skyfi.com.vn/api/sms
